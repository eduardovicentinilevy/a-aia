{
  "name": "acaia",
  "private": true,
  "description": "AçaIA — assistente de IA em português do Brasil",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "env:init": "node scripts/env-init.mjs",
    "db:up": "node scripts/env-upgrade.mjs && docker compose -f infra/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:logs": "docker compose -f infra/docker-compose.yml logs -f db",
    "db:migrate": "node scripts/env-upgrade.mjs && npm run db:migrate -w apps/api",
    "db:rollback": "npm run db:rollback -w apps/api --",
    "dev": "node scripts/dev.mjs",
    "test": "npm run test --workspaces --if-present",
    "pro:models": "npm run pro:models -w apps/api",
    "desktop:install": "npm ci --prefix apps/desktop",
    "desktop:start": "npm run start --prefix apps/desktop",
    "desktop:dist": "npm run dist --prefix apps/desktop",
    "desktop:test": "npm test --prefix apps/desktop"
  },
  "allowScripts": {
    "@firebase/util": false
  }
}
