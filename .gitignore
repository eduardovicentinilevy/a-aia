# Dependencies
node_modules/

# Secrets — never commit
.env
.env.*
!.env.example

# Logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Build output
dist/
# Desktop app (apps/desktop): bundled API + web, and the installers
apps/desktop/build/
apps/desktop/release/

# Test and coverage output
coverage/

# Python / ML (Phases 2–3)
__pycache__/
.venv/
*.safetensors
*.bin
*.gguf
ml/runs/**/checkpoints/
# Raw model answers from the evaluation harness (reports in ml/eval/reports ARE committed)
ml/eval/results/
# Downloaded public datasets and the built train/val files (rebuild with ml/data/build_dataset.py)
ml/data/cache/
ml/data/out/

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
