# AçaIA — environment variables.
# Copy to .env with `npm run env:init` and edit. NEVER commit the .env file.

# --- API --------------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# Docker database (npm run db:up) on port 5433. Use 127.0.0.1, not "localhost": on Windows
# "localhost" may reach another PostgreSQL installed on the machine.
DATABASE_URL=postgres://acaia:acaia@127.0.0.1:5433/acaia

# --- Web (React + Vite) -----------------------------------------------------
# Only WEB_PORT and VITE_* are read by the web app (see apps/web/vite.config.js).
# Port of the local chat page. If you change it, change CORS_ORIGIN too.
WEB_PORT=5173
# API address used by the browser. VITE_* values are PUBLIC (they go into the bundle):
# never put a secret in a VITE_ variable.
VITE_API_BASE_URL=http://localhost:8080
# Firebase web config (Firebase console → Project settings → Your apps → Web app).
# Public by design. All empty = login screen disabled (development).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Login (Firebase Auth) -------------------------------------------------
# Empty = login disabled: everybody is the local "Dev local" user (development only).
FIREBASE_PROJECT_ID=
# Invite list for the closed test: comma-separated e-mails (must be VERIFIED in Firebase).
# Admins are always invited. Empty = everybody (development only; required in production).
ALLOWED_EMAILS=
ADMIN_EMAILS=

# --- Phase 4+ (PDFs) ---------------------------------------------------------
GCS_BUCKET=

# --- AçaIA Copinho (Phase 3) ----------------------------------------------
COPINHO_BASE_URL=http://localhost:8000/v1
COPINHO_MODEL=acaia-copinho
COPINHO_TIMEOUT_MS=20000

# --- AçaIA Pro --------------------------------------------------------------
# PRO_PROVIDER:
#   mock               -> fake replies, no key, no internet, no cost (default)
#   openai-compatible  -> any provider with an OpenAI-compatible /chat/completions endpoint
# Free option used in Phase 0: Gemini API free tier (see docs/RUNBOOK.md, "Configurar o Pro").
#   PRO_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   PRO_MODEL=<a model listed by `npm run pro:models`>
PRO_PROVIDER=mock
PRO_BASE_URL=
PRO_API_KEY=
PRO_MODEL=
PRO_TIMEOUT_MS=30000
# Hard cap on tokens generated per answer (protects your quota).
MAX_OUTPUT_TOKENS=1024
# Estimated Pro price in BRL per 1 million tokens, used for cost tracking (0 on a free tier).
PRO_COST_INPUT_BRL_PER_1M=0
PRO_COST_OUTPUT_BRL_PER_1M=0

# --- Phase 4+ -------------------------------------------------------------
EMBEDDINGS_PROVIDER=
EMBEDDINGS_MODEL=
EMBEDDINGS_DIM=
SEARCH_PROVIDER=
SEARCH_API_KEY=

# --- Moderation ------------------------------------------------------------
# keyword = basic list of clearly harmful requests in Portuguese (Phase 1); mock = allow all (tests).
MODERATION_PROVIDER=keyword

# --- Limits and budget -----------------------------------------------------
# Tokens (in + out) per user per day, São Paulo time. 0 = no limit.
DAILY_TOKEN_LIMIT_PER_USER=50000
# Estimated spend for ALL users in the month; the API stops calling paid models when it is reached.
MONTHLY_BUDGET_BRL=150
