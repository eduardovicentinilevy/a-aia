# AçaIA — environment variables.
# Copy to .env with `npm run env:init` and edit. NEVER commit the .env file.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://acaia:acaia@localhost:5432/acaia

# --- Phase 1+ -------------------------------------------------------------
FIREBASE_PROJECT_ID=
GCS_BUCKET=

# --- AçaIA Copinho (Phase 3) ----------------------------------------------
COPINHO_BASE_URL=http://localhost:8000/v1
COPINHO_MODEL=acaia-copinho
COPINHO_TIMEOUT_MS=20000

# --- AçaIA Pro --------------------------------------------------------------
# PRO_PROVIDER:
#   mock               -> fake replies, no key, no internet, no cost (default)
#   openai-compatible  -> any provider with an OpenAI-compatible /chat/completions endpoint
# Free option used in Phase 0: Gemini API free tier (see docs/RUNBOOK.md, "Configurar o Pro").
#   PRO_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   PRO_MODEL=<a model listed by `npm run pro:models`>
PRO_PROVIDER=mock
PRO_BASE_URL=
PRO_API_KEY=
PRO_MODEL=
PRO_TIMEOUT_MS=30000
# Hard cap on tokens generated per answer (protects your quota).
MAX_OUTPUT_TOKENS=1024

# --- Phase 4+ -------------------------------------------------------------
EMBEDDINGS_PROVIDER=
EMBEDDINGS_MODEL=
EMBEDDINGS_DIM=
SEARCH_PROVIDER=
SEARCH_API_KEY=
MODERATION_PROVIDER=

# --- Limits and budget (enforced from Phase 1) ------------------------------
DAILY_TOKEN_LIMIT_PER_USER=50000
MONTHLY_BUDGET_BRL=150
ADMIN_EMAILS=
