{
  "name": "@acaia/api",
  "version": "0.1.0",
  "private": true,
  "description": "API da AçaIA (Node.js + Express)",
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "pro:models": "node --env-file-if-exists=../../.env scripts/list-models.js",
    "db:migrate": "node --env-file-if-exists=../../.env scripts/migrate.js up",
    "db:rollback": "node --env-file-if-exists=../../.env scripts/migrate.js down"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2",
    "vitest": "^5.1.2"
  }
}
